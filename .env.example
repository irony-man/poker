# Copy to `.env` and fill secrets. Compose reads this via env_file + ${VAR} substitution.
# Local defaults work with `docker compose up`; Oracle/pokr.site values shown in comments.

# ── Nest server ──────────────────────────────────────────────
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Production (Oracle + Caddy):
# WEB_ORIGIN=https://pokr.site,https://www.pokr.site
DATA_DIR=/app/data
ADMIN_USERNAMES=shivam,slick

# Compose Postgres (service hostname `postgres`). For local npm without Compose use 127.0.0.1.
DATABASE_URL=postgres://poker:poker@postgres:5432/poker
# DATABASE_URL=postgresql://postgres.<project-ref>:[PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
# SUPABASE_REGION=ap-southeast-1
# REDIS_URL=redis://127.0.0.1:6379

# AWS S3 (avatars / static assets). See docs/s3-setup.md
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_BASE_URL=

# ── Next web (NEXT_PUBLIC_* baked at image build — rebuild after changes) ──
NEXT_PUBLIC_SITE_URL=https://pokr.site
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
# Production (Oracle + Caddy):
# NEXT_PUBLIC_API_URL=https://pokr.site
# NEXT_PUBLIC_WS_URL=wss://pokr.site/ws
API_REWRITE_TARGET=http://server:4000
NEXT_PUBLIC_ASSETS_URL=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
