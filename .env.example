# Copy to `.env` and fill secrets. Compose reads this via env_file + ${VAR} substitution.
# `docker compose up` does NOT start local Postgres — use Supabase (or `npm run db:up` for local).

# ── Nest server ──────────────────────────────────────────────
PORT=4000
WEB_ORIGIN=https://pokr.site,https://www.pokr.site
DATA_DIR=/app/data
ADMIN_USERNAMES=shivam,slick

# Supabase Session pooler (IPv4). Dashboard → Project Settings → Database → Connection string → Session mode.
# Replace [PASSWORD] and region/ref. Do not use db.<ref>.supabase.co (IPv6-only) on many VMs.
DATABASE_URL=postgresql://postgres.<project-ref>:[PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_REGION=
# REDIS_URL=redis://127.0.0.1:6379

# ── Bot chat / table banter LLM (OpenAI-compatible) ──────────
# Recommended on Oracle VM: a hosted API (OpenAI / OpenRouter / Together). Leave unset for template banter only.
#
# Hosted example:
# BANTER_LLM_BASE_URL=https://api.openai.com
# BANTER_LLM_API_KEY=sk-...
# BANTER_LLM_MODEL=gpt-4o-mini
# BOT_CHAT_MODEL=gpt-4o-mini
# BANTER_LLM_PATH=/v1/chat/completions
# BANTER_LLM_TIMEOUT_MS=8000
# BOT_CHAT_TIMEOUT_MS=60000
#
# Local FunGPT sidecar (dev or `docker compose --profile fungpt`):
# BANTER_LLM_BASE_URL=http://127.0.0.1:8000
# Inside Compose with --profile fungpt use: BANTER_LLM_BASE_URL=http://fungpt:8000
# BANTER_LLM_API_KEY=          # optional; mirrors FUNGPT_API_KEY on the sidecar
# BANTER_LLM_MODEL=banterbot
# FUNGPT_ROOT=/home/shivam/work/FunGPT

# AWS S3 (avatars / static assets). See docs/s3-setup.md
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_BASE_URL=

# ── Next web (NEXT_PUBLIC_* + API_REWRITE_TARGET baked at image build) ──
NEXT_PUBLIC_SITE_URL=https://pokr.site
NEXT_PUBLIC_API_URL=https://pokr.site
NEXT_PUBLIC_WS_URL=wss://pokr.site/ws
API_REWRITE_TARGET=http://server:4000
NEXT_PUBLIC_ASSETS_URL=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
