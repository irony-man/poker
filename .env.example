# Copy to `.env` and fill secrets. Compose reads this via env_file + ${VAR} substitution.
# `docker compose up` does NOT start local Postgres — use Supabase (or `npm run db:up` for local).

# ── Nest server ──────────────────────────────────────────────
PORT=4000
WEB_ORIGIN=https://pokr.site,https://www.pokr.site
DATA_DIR=/app/data
ADMIN_USERNAMES=shivam,slick

# Supabase Session pooler (IPv4). Dashboard → Project Settings → Database → Connection string → Session mode.
# Replace [PASSWORD] and region/ref. Do not use db.<ref>.supabase.co (IPv6-only) on many VMs.
DATABASE_URL=postgresql://postgres.<project-ref>:[PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_REGION=

# Optional Redis (auth sessions / WS tickets / email tokens with TTL, table snapshots, pub/sub).
# Unset → sessions stay in Postgres (or users.json) and the KV falls back to in-memory.
# Local: `npm run redis:up` then REDIS_URL=redis://127.0.0.1:6379
# Compose server talking to the local-redis profile: REDIS_URL=redis://redis:6379
# Managed (Upstash / Redis Cloud): use the provider's TLS URL, e.g. rediss://default:<pw>@<host>:6379
# Use a persistent Redis (AOF/RDB): flushing it signs everyone out.
# REDIS_URL=redis://127.0.0.1:6379

# ── Bot chat / table banter LLM (OpenAI-compatible) ──────────
# Recommended on Oracle VM: a hosted API (OpenAI / OpenRouter / Together). Leave unset for template banter only.
#
# Hosted example:
# BANTER_LLM_BASE_URL=https://api.openai.com
# BANTER_LLM_API_KEY=sk-...
# BANTER_LLM_MODEL=gpt-4o-mini
# BOT_CHAT_MODEL=gpt-4o-mini
# BANTER_LLM_PATH=/v1/chat/completions
# BANTER_LLM_TIMEOUT_MS=8000
# BOT_CHAT_TIMEOUT_MS=60000
#
# Lobby /chat only (Cohere compatibility API — fast; table banter can stay on FunGPT):
# BOT_CHAT_LLM_BASE_URL=https://api.cohere.ai/compatibility/v1
# BOT_CHAT_LLM_API_KEY=
# BOT_CHAT_MODEL=command-r-plus-08-2024
# BOT_CHAT_BOOST_MODEL=command-r-plus-08-2024   # optional; Boost bot mode on /chat (same Cohere key)
# BOT_CHAT_LLM_PATH=/chat/completions   # optional; auto for Cohere compatibility base URL
# BOT_CHAT_TIMEOUT_MS=60000
#
# Table banter + optional fallback for /chat (FunGPT sidecar; run ./scripts/download-banterbot-weights.sh):
# BANTER_LLM_BASE_URL=http://fungpt:8000
# BANTER_LLM_MODEL=banterbot
# Pick ONE sidecar secret (server + fungpt must match after recreate; do not reuse BOT_CHAT_LLM_API_KEY):
# BANTER_LLM_API_KEY=change-me-local-fungpt
# FUNGPT_API_KEY=change-me-local-fungpt
# BANTERBOT_WEIGHTS_ROOT=./apps/fungpt/weights

# ── Google sign-in ───────────────────────────────────────────
# OAuth "Web application" client id (Google Cloud → APIs & Services → Credentials).
# Web and Android both request ID tokens for this id. See docs/DEPLOY.md.
GOOGLE_CLIENT_ID=

# ── Instagram sign-in ────────────────────────────────────────
# Meta Developer App → Instagram → API setup with Instagram login (Business type app).
# Redirect URI must match INSTAGRAM_REDIRECT_URI (default: $PUBLIC_WEB_URL/auth/instagram/callback).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Instagram Business Login rejects http://localhost redirect URIs.
# INSTAGRAM_REDIRECT_URI=https://localhost:3000/auth/instagram/callback

# ── Recovery email / password reset (SMTP via nodemailer) ────
# Leave SMTP_HOST empty in dev: verification/reset links are logged to the server console.
# Zoho: smtp.zoho.com / smtppro.zoho.com (use .in / .eu for those regions). Gmail: smtp.gmail.com.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Pokr <no-reply@pokr.site>"
# Base URL used in email links (defaults to the first WEB_ORIGIN).
PUBLIC_WEB_URL=https://pokr.site

# AWS S3 (avatars / static assets). See docs/s3-setup.md
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_BASE_URL=

# ── Next web (NEXT_PUBLIC_* + API_REWRITE_TARGET baked at image build) ──
NEXT_PUBLIC_SITE_URL=https://pokr.site
NEXT_PUBLIC_API_URL=https://pokr.site
NEXT_PUBLIC_WS_URL=wss://pokr.site/ws
API_REWRITE_TARGET=http://server:4000
NEXT_PUBLIC_ASSETS_URL=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
# Optional: bake the Google client id into the web build. Blank → read from GET /api/auth/config.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Filled into /privacy and /terms ({{operatorName}}, {{contactEmail}}, {{jurisdiction}}).
NEXT_PUBLIC_LEGAL_OPERATOR_NAME=
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=
NEXT_PUBLIC_LEGAL_JURISDICTION=
