# Production defaults match apps/android when these are unset.
# EXPO_PUBLIC_API_URL=https://felt-server-hgi4.onrender.com
# EXPO_PUBLIC_WS_URL=wss://felt-server-hgi4.onrender.com/ws

# Local server (apps/server on :4000):
# Android emulator: http://10.0.2.2:4000 and ws://10.0.2.2:4000/ws
# iOS simulator:    http://localhost:4000 and ws://localhost:4000/ws
# Physical device:  http://<lan-ip>:4000 and ws://<lan-ip>:4000/ws
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_WS_URL=ws://localhost:4000/ws
