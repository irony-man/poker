{
  "name": "@poker/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint .",
    "typecheck": "npm run build -w @poker/engine -w @poker/protocol && tsc -p tsconfig.json --noEmit",
    "test": "npm run build -w @poker/engine -w @poker/protocol && node scripts/check-metro.mjs && node scripts/jest.mjs",
    "bundle:smoke": "node scripts/bundle-smoke.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.14",
    "@poker/engine": "*",
    "@poker/protocol": "*",
    "expo": "~58.0.16",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.24",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.1",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.18",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~58.0.4",
    "jest": "^29.7.0",
    "jest-expo": "~58.0.11",
    "typescript": "~5.7.2"
  }
}
